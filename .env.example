# 중계 서버 주소. 값이 있으면 브라우저 API 키보다 우선합니다.
# 아래 기본 주소를 사용하면 키가 비어 있어도 실제 API 요청이 발생합니다.
VITE_AI_PROXY=https://our-yangju.mikael8047.workers.dev

# 로컬 직접 호출·수집·평가 스크립트용 키. 공개 빌드에 포함하지 마세요.
VITE_CLAUDE_API_KEY=
# 저장소 기본 모델. 실제 API와 Worker 허용 목록을 확인해 설정하세요.
VITE_CLAUDE_MODEL=claude-haiku-5-5

# 데모 모드: VITE_AI_PROXY와 VITE_CLAUDE_API_KEY를 모두 비우고,
# 담당자 화면에서 이전에 저장한 키도 삭제하세요.
