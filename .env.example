# Claude API 키 (https://platform.claude.com/settings/keys)
# 브라우저에서 직접 호출하는 구조라 시연용으로만. 비우면 데모 모드(샘플 데이터·규칙만)
VITE_CLAUDE_API_KEY=
# 사용할 모델 (기본값 claude-haiku-5-5: 빠르고 싸다. 정확도가 더 필요하면 claude-sonnet-5-5)
VITE_CLAUDE_MODEL=claude-haiku-5-5
# 중계 서버(worker/) 주소. 있으면 브라우저에 키가 필요 없다
VITE_AI_PROXY=https://our-yangju.mikael8047.workers.dev
